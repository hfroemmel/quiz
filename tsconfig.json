{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/themes/scripts/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "packages/react/src",
    "packages/react/test"
  ]
}
