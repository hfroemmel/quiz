{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/desktop/src/**/*.ts",
    "apps/kiosk/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  // Die Praesentationsschicht braucht JSX und DOM-Typen und wird deshalb
  // ueber ihr eigenes Projekt geprueft (siehe Skript "typecheck").
  "exclude": ["**/node_modules", "**/dist", "packages/presentation", "packages/client", "packages/game"]
}
