node_modules/

# Build-Artefakte der Anwendungen (werden aus den Quellen erzeugt)
apps/web/dist/
apps/desktop/dist/
apps/kiosk/dist/
dist-electron/
release/
*.tsbuildinfo

# Laufzeitdaten des lokalen Servers (SQLite, Logs, Exporte).
# Der fuehrende Schraegstrich ist wichtig: ohne ihn wuerde das Muster auch
# packages/runtime/ erfassen, also ein Quellpaket.
/runtime/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Rohdaten aus dem optionalen Sheet-Abruf: noch nicht redaktionell freigegeben
content/incoming/
# Migrationsvorschlaege aus den Legacy-Quellen: brauchen menschliche Freigabe
content/migrated/
# Das gebaute Paket entsteht bei jedem "pnpm content:build" neu und waere hier
# eine Verdopplung des Testbestands.
content/dist/
content/dist-no-video/
# Eine gepflegte Sperrdatei zeigt auf einen echten Inhaltsstand und gehoert der
# jeweiligen Anwendung; im Testrepository bleibt es bei der Vorlage.
content.lock.json

# Playwright
test-results/
playwright-report/
.playwright/

# Editor / OS
.DS_Store
.vscode/
.idea/

packages/*/dist/
