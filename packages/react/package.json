{
  "name": "@hfroemmel/quiz-react",
  "version": "0.22.1",
  "type": "module",
  "description": "React presentation layer of the stage: QuizScene, scenes, sounds and connection hooks",
  "exports": {
    ".": "./src/index.ts",
    "./styles/stage.css": "./src/styles/stage.css",
    "./styles/motion.css": "./src/styles/motion.css",
    "./assets/*": "./src/assets/*"
  },
  "dependencies": {
    "@hfroemmel/quiz-core": "workspace:*",
    "@hfroemmel/quiz-themes": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/quiz-react.css",
      "./styles/stage.css": "./dist/styles/stage.css",
      "./styles/motion.css": "./dist/styles/motion.css",
      "./assets/*": "./dist/assets/*"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.4"
  },
  "scripts": {
    "build": "vite build && rm -rf dist/styles dist/assets && cp -r src/styles dist/styles && mkdir -p dist/assets && cp -r src/assets/kinderquiz dist/assets/kinderquiz"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
