{
  "name": "@hfroemmel/quiz-kiosk",
  "version": "0.14.0",
  "type": "module",
  "description": "Das spielbare Quiz als eine Komponente: Startauswahl, Spiel und Ergebnis fuer Kiosk und Einbettung",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@hfroemmel/quiz-core": "workspace:*",
    "@hfroemmel/quiz-react": "workspace:*",
    "@hfroemmel/quiz-themes": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/quiz-kiosk.css"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.4"
  },
  "scripts": {
    "build": "vite build"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
