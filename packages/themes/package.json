{
  "name": "@hfroemmel/quiz-themes",
  "version": "0.26.10",
  "type": "module",
  "description": "Presentation of the stage: colour palettes, fonts and theme objects for QuizScene",
  "exports": {
    ".": "./src/index.ts",
    "./palette.css": "./src/palette.css",
    "./fonts.css": "./src/fonts.css",
    "./controls.css": "./src/controls.css"
  },
  "dependencies": {
    "@hfroemmel/quiz-core": "workspace:*",
    "zod": "^3.24.1"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "palette:build": "tsx scripts/build-palette.ts",
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --target node20 && cp src/palette.css src/fonts.css src/controls.css dist/ && rm -rf dist/fonts && cp -r src/fonts dist/fonts"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./palette.css": "./dist/palette.css",
      "./fonts.css": "./dist/fonts.css",
      "./controls.css": "./dist/controls.css"
    }
  }
}
