{
  "name": "@hfroemmel/quiz-content",
  "version": "0.0.0",
  "type": "module",
  "description": "Quizdaten-Pipeline: Legacy-Import, Normalisierung, Validierung, versionierte Pakete, Hotfix-Overlay",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@hfroemmel/quiz-core": "workspace:*",
    "zod": "^3.24.1"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --target node20"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
