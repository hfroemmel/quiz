{
  "name": "@quiz/content",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Quizdaten-Pipeline: Legacy-Import, Normalisierung, Validierung, versionierte Pakete, Hotfix-Overlay",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@quiz/contracts": "workspace:*",
    "@quiz/domain": "workspace:*",
    "zod": "^3.24.1"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --target node20"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
