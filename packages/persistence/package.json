{
  "name": "@quiz/persistence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SQLite-Persistenz: Migrationen, Repositories, transaktionale Befehlsverarbeitung",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@hfroemmel/quiz-core": "workspace:*",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --target node20"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
