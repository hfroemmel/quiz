{
  "name": "@quiz/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Transportadapter des Buehnenbetriebs: HTTP-Auslieferung, WebSocket-Verteilung, Zugriffsregeln",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@hfroemmel/quiz-content": "workspace:*",
    "@hfroemmel/quiz-core": "workspace:*",
    "@quiz/persistence": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --sourcemap --clean --target node20"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./main": {
        "types": "./dist/main.d.ts",
        "import": "./dist/main.js"
      }
    }
  }
}
