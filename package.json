{
  "name": "quiz",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Libraries of the live quiz: core, content pipeline, themes, React stage and the playable quiz",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "packages:build": "pnpm -r --filter './packages/*' run build",
    "packages:verify": "node scripts/verify-packages.mjs",
    "packages:tag": "node scripts/tag-release.mjs",
    "typecheck": "tsc -b --force tsconfig.json && tsc -p harness/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:fixtures": "node scripts/build-content-fixtures.mjs",
    "content:pull": "tsx packages/content/src/cli/index.ts pull",
    "content:fetch": "tsx packages/content/src/cli/fetch.ts",
    "content:assets": "tsx packages/content/src/cli/generate-demo-assets.ts",
    "content:migrate": "tsx packages/content/src/cli/migrate-legacy.ts",
    "content:migrate-v2": "tsx packages/content/src/cli/migrate-v2.ts",
    "content:validate": "tsx packages/content/src/cli/validate.ts",
    "content:validate:dev": "tsx packages/content/src/cli/validate.ts --placeholder-media",
    "content:build": "tsx packages/content/src/cli/build.ts",
    "content:build:dev": "tsx packages/content/src/cli/build.ts --placeholder-media",
    "palette:build": "pnpm --filter @hfroemmel/quiz-themes run palette:build",
    "harness": "pnpm --filter @quiz/harness dev",
    "lint": "pnpm typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.2",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^2.1.8"
  }
}
