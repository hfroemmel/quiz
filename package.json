{
  "name": "live-quiz",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Live-Quiz-Regiesystem fuer Buehnenveranstaltungen (Operator, Buehnenscreen, Moderator)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "packages:build": "pnpm -r --filter './packages/*' run build",
    "packages:verify": "node scripts/verify-packages.mjs",
    "typecheck": "tsc -b --force tsconfig.json && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:fetch": "tsx packages/content/src/cli/fetch.ts",
    "content:assets": "tsx packages/content/src/cli/generate-demo-assets.ts",
    "content:migrate": "tsx packages/content/src/cli/migrate-legacy.ts",
    "content:migrate-v2": "tsx packages/content/src/cli/migrate-v2.ts",
    "content:validate": "tsx packages/content/src/cli/validate.ts",
    "content:validate:dev": "tsx packages/content/src/cli/validate.ts --placeholder-media",
    "content:build": "tsx packages/content/src/cli/build.ts",
    "content:build:dev": "tsx packages/content/src/cli/build.ts --placeholder-media",
    "palette:build": "pnpm --filter @hfroemmel/quiz-themes run palette:build",
    "server": "tsx packages/server/src/main.ts",
    "dev": "concurrently -n web,server -c cyan,magenta \"pnpm --filter @quiz/web dev\" \"tsx packages/server/src/main.ts\"",
    "dev:desktop": "pnpm --filter @quiz/desktop dev",
    "build": "pnpm palette:build && pnpm content:validate && pnpm --filter @quiz/web build",
    "build:dev": "pnpm palette:build && pnpm content:validate:dev && pnpm --filter @quiz/web build",
    "build:desktop": "pnpm build && pnpm --filter @quiz/desktop build",
    "build:kiosk": "pnpm build && pnpm --filter @quiz/kiosk build",
    "dev:kiosk": "pnpm --filter @quiz/kiosk dev",
    "lint": "pnpm typecheck",
    "desktop:rebuild-native": "pnpm --filter @quiz/desktop rebuild:native",
    "server:rebuild-native": "node scripts/rebuild-native-for-node.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "esbuild": "^0.24.2",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^2.1.8"
  }
}
